# Copy this file to .env.local and fill in what you need.
# Everything here is optional except the two Supabase values — without those the
# shop runs against browser localStorage and orders never reach you.

# ---------------------------------------------------------------- database
# Supabase dashboard -> Project Settings -> API
#
# Both are safe in the browser. The anon key is designed to be public; what
# protects your data is the row-level security in supabase/schema.sql.
# Never put the service_role key here — that one bypasses all security.
#
# Leave these blank to keep running against browser localStorage.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key


# ------------------------------------------------------------------- site
# The public address of the shop, used for canonical URLs, sitemap.xml and the
# link previews that show up when someone pastes the shop into WhatsApp.
# No trailing slash.

VITE_SITE_URL=https://asmar-store.netlify.app


# -------------------------------------------------------------- analytics
# Cookieless, so no consent banner is needed. Leave the domain blank and no
# analytics script loads at all.
#   plausible -> VITE_ANALYTICS_DOMAIN is your site domain (asmar-store.netlify.app)
#   umami     -> VITE_ANALYTICS_DOMAIN is your website id (a uuid)
# VITE_ANALYTICS_HOST is only needed if you self-host either one.

VITE_ANALYTICS_PROVIDER=plausible
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_HOST=


# ------------------------------------------------------------ error reports
# A URL that accepts a JSON POST. Gets a message, a stack trace and the page
# it happened on whenever the shop crashes for a customer. Leave blank to log
# crashes to the browser console only.

VITE_ERROR_WEBHOOK=
